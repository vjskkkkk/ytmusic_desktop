{
  "name": "ytmini",
  "version": "0.3.1",
  "description": "YouTube Music desktop app for Windows with a resizable mini player",
  "main": "src/main/index.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "vitest run",
    "dist": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.ytmini.app",
    "productName": "YT Mini",
    "icon": "assets/icon.png",
    "files": [
      "src/main/**",
      "src/preload/**",
      "dist-renderer/**",
      "assets/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "jszip": "^3.10.2",
    "svelte": "^5.57.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wait-on": "^9.1.0",
    "webamp": "2.3.1"
  },
  "dependencies": {
    "youtubei.js": "18.1.0"
  }
}
